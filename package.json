{
  "name": "pedo-edhellen",
  "productName": "Pedo Edhellen",
  "description": "Learn Tolkien's Sindarin and Quenya",
  "author": "HoodedHacker",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "test": "node --test tests/course.test.js tests/app.test.js tests/writing.test.js",
    "icons": "node scripts/icons.mjs",
    "build:artifact": "vite build --mode artifact && node scripts/to-artifact.mjs",
    "build:desktop": "vite build --mode desktop",
    "build:pwa": "vite build --mode pwa",
    "desktop": "npm run build:desktop && electron .",
    "desktop:probe": "npm run build:desktop && electron . --probe",
    "probe": "node tools/probe.mjs",
    "pwa": "npm run build:pwa && vite preview --outDir dist-pwa --port 5195",
    "dist:win": "npm run build:desktop && electron-builder --win portable",
    "build:site": "vite build --mode pwa && node site/build.mjs",
    "site": "npm run build:site && node tools/serve-site.mjs"
  },
  "build": {
    "appId": "com.hoodedhacker.pedoedhellen",
    "productName": "Pedo Edhellen",
    "files": [
      "desktop/**",
      "dist-desktop/**",
      "package.json",
      "!desktop/**/*.md"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "PedoEdhellen-${version}-portable.exe"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3"
  }
}
